{
  "name": "@thorvg/react-native-thorvg",
  "version": "0.1.0",
  "description": "ThorVG for React Native powered by @thorvg/webcanvas API running on Android, iOS and web",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "thorvg-react-native-thorvg-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "setup-thorvg-web": "scripts/setup-thorvg-web.mjs"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "scripts/setup-thorvg-web.mjs",
    "!ios/build",
    "!android/build",
    "!android/.cxx",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @thorvg/react-native-thorvg-example",
    "build:thorvg": "./scripts/build-thorvg.sh",
    "package:binaries": "node scripts/package-binaries.mjs",
    "generate": "node scripts/generate-constants.mjs",
    "clean": "del-cli lib android/build android/.cxx example/android/build example/android/app/build example/ios/build",
    "prepare": "node scripts/generate-constants.mjs && bob build",
    "typecheck": "tsc && tsc -p example",
    "lint": "eslint \"**/*.{js,ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "web",
    "thorvg",
    "lottie",
    "svg",
    "vector-graphics",
    "canvas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyjin/react-native-thorvg.git"
  },
  "author": "Jinny You <baram991103@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tinyjin/react-native-thorvg/issues"
  },
  "homepage": "https://thorvg.org",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@thorvg/webcanvas": "~1.1.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@types/react": "^19.2.0",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "version": "^4.18.0"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "ReactNativeThorVGSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "org.thorvg.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "ThorVG": "ThorVGModule"
      },
      "components": {
        "ThorVGView": {
          "className": "ThorVGView"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.64.0"
  }
}
